# SafeLine CE — environment template.
#
# Copy to `.env` and fill in the two values marked CHANGE ME, then start with:
#   docker compose --env-file .env up -d
# The real `.env` is gitignored (it holds a password); this template is committed.

# --- where SafeLine keeps runtime data (postgres, logs, nginx config) ---
# CHANGE ME: use an ABSOLUTE path on THIS machine. Keeping it in-repo (gitignored) is fine:
#   e.g. /home/<you>/waf-bypass-lab/safeline/data
SAFELINE_DIR=/CHANGE/ME/waf-bypass-lab/safeline/data

# --- image source (x86_64 -> ARCH_SUFFIX empty; ARM64 -> set ARCH_SUFFIX=-arm) ---
IMAGE_PREFIX=chaitin
IMAGE_TAG=latest
REGION=-g
ARCH_SUFFIX=

# --- private /24 bridge for SafeLine's control-plane containers ---
# CHANGE ME if this subnet is already in use on this host (compose will error:
# "Pool overlaps with other one on this address space"). Pick any free /24 — find one with:
#   for n in $(docker network ls --format '{{.Name}}'); do \
#     docker network inspect "$n" --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'; done
# Good candidates: 172.30.222 / 172.29.222 / 192.168.222 (must be free on THIS host).
SUBNET_PREFIX=172.30.222

# --- dashboard: https://127.0.0.1:9443 (bound to loopback in compose.yaml) ---
MGT_PORT=9443
MGT_PROXY=

# --- internal Postgres password (container-internal only) ---
# CHANGE ME: generate a fresh one, e.g.
#   LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom | head -c 32
POSTGRES_PASSWORD=CHANGE_ME_generate_32_random_chars
